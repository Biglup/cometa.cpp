PROJECT_NAME = Cometa.cpp
OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/doxygen"
INPUT = "@COMETA_ROOT@/lib/include/cometa"
RECURSIVE = YES
FILE_PATTERNS = *.hpp
GENERATE_HTML = NO
GENERATE_LATEX = NO
GENERATE_XML = YES
QUIET = YES
WARN_AS_ERROR = YES
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
WARN_IF_UNDOCUMENTED = YES
