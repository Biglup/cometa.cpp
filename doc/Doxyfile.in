PROJECT_NAME = Cometa.cpp
OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/doxygen"
INPUT = "@COMETA_ROOT@/lib/include/Cometa"
RECURSIVE = YES
FILE_PATTERNS = *.h
GENERATE_HTML = NO
GENERATE_LATEX = NO
GENERATE_XML = YES
QUIET = YES
WARN_AS_ERROR = YES
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC = YES

DOT_GRAPH_MAX_NODES = 1024
