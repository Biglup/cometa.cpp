@INCLUDE = "@CMAKE_CURRENT_BINARY_DIR@/Doxyfile"
INPUT = "@COMETA_ROOT@/lib/include/Cometa" "@COMETA_ROOT@/lib/src"
FILE_PATTERNS = *.h *.cpp
OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/documentation-check"
GENERATE_XML = YES
EXTRACT_PRIVATE = YES
EXTRACT_STATIC = YES
EXTRACT_ANON_NSPACES = YES
INTERNAL_DOCS = YES

DOT_GRAPH_MAX_NODES = 1024
