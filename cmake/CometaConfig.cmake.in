@PACKAGE_INIT@

IF (NOT TARGET Cometa::cardano)
  ADD_LIBRARY (Cometa::cardano STATIC IMPORTED)

  SET_TARGET_PROPERTIES (Cometa::cardano
    PROPERTIES
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cometa/@CMAKE_STATIC_LIBRARY_PREFIX@cardano-c@CMAKE_STATIC_LIBRARY_SUFFIX@"
  )

  IF (UNIX)
    SET_PROPERTY (TARGET Cometa::cardano PROPERTY INTERFACE_LINK_LIBRARIES m)
  ENDIF ()
ENDIF ()

INCLUDE ("${CMAKE_CURRENT_LIST_DIR}/CometaTargets.cmake")

SET (Cometa_curl_FOUND FALSE)

IF (@COMETA_HAS_CURL@)
  FIND_PACKAGE (CURL QUIET)

  IF (CURL_FOUND)
    INCLUDE ("${CMAKE_CURRENT_LIST_DIR}/CometaCurlTargets.cmake")
    SET (Cometa_curl_FOUND TRUE)
  ENDIF ()
ENDIF ()

CHECK_REQUIRED_COMPONENTS (Cometa)
