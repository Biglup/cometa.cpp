file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../VERSION" version_fields)
foreach(field IN LISTS version_fields)
  if(field MATCHES "^VERSION_(MAJOR|MINOR|PATCH|PRERELEASE)=(.*)$")
    set(VERSION_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
  endif()
endforeach()
set(COMETA_VERSION "${VERSION_MAJOR}.${VERSION_MINOR}.${VERSION_PATCH}")
set(COMETA_FULL_VERSION "${COMETA_VERSION}")
if(NOT "${VERSION_PRERELEASE}" STREQUAL "")
  string(APPEND COMETA_FULL_VERSION "-${VERSION_PRERELEASE}")
endif()
